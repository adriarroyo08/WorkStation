{
  "name": "workstation-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP para que cualquier IA lea y escriba tus datos de entrenamiento de Workstation",
  "bin": {
    "workstation-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
