{
  "name": "workstation",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "npm --prefix app run build && npm --prefix mcp run build",
    "catalog": "node scripts/build-catalog.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"app/src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\" \"mcp/src/**/*.ts\" \"video/src/**/*.tsx\"",
    "typecheck": "tsc --noEmit -p app && tsc --noEmit -p app/tsconfig.node.json && tsc --noEmit -p mcp && tsc --noEmit -p video",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm --prefix app run build && npm --prefix mcp run build:edge",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
