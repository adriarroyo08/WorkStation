{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "../shared", "vite.config.ts"],
  "exclude": ["../shared/**/*.test.ts", "../shared/mcp-tools.ts", "../shared/mcp-http.ts", "../shared/cloud-source.ts"]
}
